{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://specs.nimrod.invalid/v0.1/evolution-evaluation-vector.schema.json",
  "title": "nimrod Lexicographic Evolution Evaluation Vector", "type": "object", "additionalProperties": false,
  "required": ["evaluation_version", "evaluation_id", "origin", "candidate_digest", "active_baseline_digest", "constitution_digest", "capability_report_digest", "evaluated_at", "evaluator_observations", "hard_gate_results", "champion_floor_results", "metrics", "aggregate_score_present", "status", "blockers", "candidate_executed", "active_baseline_modified", "authority"],
  "properties": {
    "evaluation_version": {"const": "0.1.0"}, "evaluation_id": {"type": "string", "format": "uuid"}, "origin": {"const": "simulated"}, "candidate_digest": {"$ref": "#/$defs/digest"}, "active_baseline_digest": {"$ref": "#/$defs/digest"}, "constitution_digest": {"$ref": "#/$defs/digest"}, "capability_report_digest": {"$ref": "#/$defs/digest"}, "evaluated_at": {"type": "string", "format": "date-time"},
    "evaluator_observations": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["evaluator_id", "logical_principal", "process_id", "role", "subject_digest", "status", "evidence"], "properties": {"evaluator_id": {"type": "string", "minLength": 1}, "logical_principal": {"type": "string", "minLength": 1}, "process_id": {"type": "integer", "minimum": 1}, "role": {"enum": ["public_regression", "sealed_holdout", "adversarial", "rights_and_recovery"]}, "subject_digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["pass", "fail", "inconclusive"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}}}}},
    "hard_gate_results": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/result"}}, "champion_floor_results": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["floor_id", "status", "evidence"], "properties": {"floor_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "regressed", "inconclusive"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}}}}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["dimension", "outcome", "evidence"], "properties": {"dimension": {"type": "string", "minLength": 1}, "outcome": {"enum": ["improved", "equal", "regressed", "unknown"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}}}}},
    "aggregate_score_present": {"const": false}, "status": {"enum": ["eligible_for_shadow", "blocked"]}, "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "candidate_executed": {"const": false}, "active_baseline_modified": {"const": false},
    "authority": {"type": "object", "additionalProperties": false, "required": ["can_promote", "can_execute", "can_modify_evaluators"], "properties": {"can_promote": {"const": false}, "can_execute": {"const": false}, "can_modify_evaluators": {"const": false}}}
  }, "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "reference": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}}, "result": {"type": "object", "additionalProperties": false, "required": ["gate_id", "status", "evidence"], "properties": {"gate_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "inconclusive"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}}}}}
}
