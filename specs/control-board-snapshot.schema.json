{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.nimrod.invalid/v0.1/control-board-snapshot.schema.json",
  "title": "nimrod Signed Control-Board Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_version", "snapshot_id", "snapshot_kind", "origin", "issuer_service_id", "audience", "sequence", "issued_at", "not_before", "expires_at", "previous_snapshot_digest", "projection_digest", "governance_state_digest", "authority", "signatures"],
  "properties": {
    "snapshot_version": {"const": "0.1.0"},
    "snapshot_id": {"$ref": "#/$defs/uuid"},
    "snapshot_kind": {"const": "verifier_projection"},
    "origin": {"enum": ["simulated", "range", "sacrificial_replica", "live"]},
    "issuer_service_id": {"$ref": "#/$defs/nonEmptyString"},
    "audience": {"const": "nimrod-control-board"},
    "sequence": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "previous_snapshot_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "governance_state_digest": {"$ref": "#/$defs/digest"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_authorize", "can_execute"],
      "properties": {
        "can_authorize": {"const": false},
        "can_execute": {"const": false}
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signer_id", "algorithm", "signature_base64"],
        "properties": {
          "signer_id": {"$ref": "#/$defs/nonEmptyString"},
          "algorithm": {"const": "Ed25519"},
          "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
        }
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1}
  }
}
