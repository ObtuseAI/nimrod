{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.nimrod.invalid/v0.1/range-connector-capability-manifest.schema.json",
  "title": "nimrod Governed Non-Provisioning Range Connector Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "manifest_id", "origin", "connector_id", "connector_version", "source_manifest_digest", "governance_state_digest", "issued_at", "not_before", "expires_at", "capability_allowlist", "operation_allowlist", "supported_environment_classes", "network_destinations", "secret_references", "installation_required", "source_tool_contact_required", "target_discovery_performed", "artifact_digest_required", "status", "blockers", "authority", "signatures"],
  "properties": {
    "manifest_version": {"const": "0.1.0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "origin": {"const": "simulated"},
    "connector_id": {"const": "connector.simulated.atomic"},
    "connector_version": {"const": "0.1.0"},
    "source_manifest_digest": {"$ref": "#/$defs/digest"},
    "governance_state_digest": {"$ref": "#/$defs/digest"},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "capability_allowlist": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "range.test.simulate"}},
    "operation_allowlist": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["preflight", "compile", "verify"]}},
    "supported_environment_classes": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "isolated_range"}},
    "network_destinations": {"type": "array", "maxItems": 0},
    "secret_references": {"type": "array", "maxItems": 0},
    "installation_required": {"const": false},
    "source_tool_contact_required": {"const": false},
    "target_discovery_performed": {"const": false},
    "artifact_digest_required": {"const": true},
    "status": {"const": "non_provisioning_contract_only_blocked"},
    "blockers": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["CONNECTOR_RUNTIME_MISSING", "LICENSE_REVIEW_NOT_APPROVED", "REAL_RANGE_ATTESTATION_MISSING"]}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_install", "can_provision", "can_connect", "can_execute", "can_discover_targets"],
      "properties": {
        "can_install": {"const": false},
        "can_provision": {"const": false},
        "can_connect": {"const": false},
        "can_execute": {"const": false},
        "can_discover_targets": {"const": false}
      }
    },
    "signatures": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_id", "algorithm", "signature_base64"],
      "properties": {
        "signer_id": {"$ref": "#/$defs/nonEmptyString"},
        "algorithm": {"const": "Ed25519"},
        "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
