{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.nimrod.invalid/v0.1/range-evidence-acceptance-report.schema.json",
  "title": "nimrod Independent Range Evidence Acceptance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "report_id", "origin", "status", "assembled_at", "policy_id", "policy_digest", "admission_report_id", "admission_report_digest", "scope_digest", "environment_id", "environment_name", "owner_named_environment", "required_control_count", "verified_decision_count", "distinct_signed_verifier_count", "real_independent_verifier_count", "retained_decisions", "control_results", "resolution_counts", "accepted_control_count", "verified_attestation_count", "evidence_complete", "blockers", "activity", "authority"],
  "properties": {
    "report_version": {"const": "0.1.0"},
    "report_id": {"type": "string", "format": "uuid"},
    "origin": {"$ref": "#/$defs/origin"},
    "status": {"enum": ["blocked_fixture_verifier_decisions_non_accepting", "blocked_unresolved_or_negative_verifier_decisions", "accepted_controls_pending_separate_evidence_completion_authority"]},
    "assembled_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string", "format": "uuid"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "admission_report_id": {"type": "string", "format": "uuid"},
    "admission_report_digest": {"$ref": "#/$defs/digest"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "environment_id": {"$ref": "#/$defs/nonEmptyString"},
    "environment_name": {"oneOf": [{"$ref": "#/$defs/nonEmptyString"}, {"type": "null"}]},
    "owner_named_environment": {"type": "boolean"},
    "required_control_count": {"const": 9},
    "verified_decision_count": {"const": 18},
    "distinct_signed_verifier_count": {"type": "integer", "minimum": 2, "maximum": 3},
    "real_independent_verifier_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "retained_decisions": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/retainedDecision"}},
    "control_results": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/controlResult"}},
    "resolution_counts": {"$ref": "#/$defs/resolutionCounts"},
    "accepted_control_count": {"type": "integer", "minimum": 0, "maximum": 9},
    "verified_attestation_count": {"const": 0},
    "evidence_complete": {"const": false},
    "blockers": {"type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/blocker"}},
    "activity": {"$ref": "#/$defs/activity"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "simulated"}}},
      "then": {
        "properties": {
          "status": {"const": "blocked_fixture_verifier_decisions_non_accepting"},
          "owner_named_environment": {"const": false},
          "real_independent_verifier_count": {"const": 0},
          "accepted_control_count": {"const": 0},
          "blockers": {"const": ["EVIDENCE_COMPLETION_AUTHORITY_MISSING", "EXECUTION_AUTHORIZATION_MISSING", "OWNER_NAMED_SACRIFICIAL_RANGE_MISSING", "RANGE_CONNECTION_AUTHORIZATION_MISSING", "REAL_INDEPENDENT_VERIFIER_ACCEPTANCE_MISSING", "REAL_READ_ONLY_OBSERVATIONS_MISSING"]}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "origin": {"enum": ["simulated", "range", "sacrificial_replica"]},
    "control": {"enum": ["CLEANUP_CONTRACT", "DEDICATED_CREDENTIALS", "DEFAULT_DENY_EGRESS", "DISPOSABLE_TARGET", "INDEPENDENT_VERIFIER", "OUT_OF_BAND_KILL", "RESTORABLE_SNAPSHOT", "TELEMETRY_SEPARATION", "TRUSTED_TIME"]},
    "resolution": {"enum": ["accepted", "rejected", "abstained", "disagreement", "timeout"]},
    "retainedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision_digest", "observation_id", "control_id", "verifier_id", "decision", "reason", "decided_at"],
      "properties": {
        "decision_id": {"type": "string", "format": "uuid"},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "observation_id": {"type": "string", "format": "uuid"},
        "control_id": {"$ref": "#/$defs/control"},
        "verifier_id": {"$ref": "#/$defs/nonEmptyString"},
        "decision": {"enum": ["accept", "reject", "abstain", "timeout"]},
        "reason": {"enum": ["evidence_supports_control", "evidence_contradicts_control", "insufficient_or_fixture_evidence", "verification_deadline_exceeded"]},
        "decided_at": {"type": "string", "format": "date-time"}
      }
    },
    "controlResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "observation_id", "observation_digest", "raw_evidence_digest", "resolution", "decision_ids", "verifier_ids"],
      "properties": {
        "control_id": {"$ref": "#/$defs/control"},
        "observation_id": {"type": "string", "format": "uuid"},
        "observation_digest": {"$ref": "#/$defs/digest"},
        "raw_evidence_digest": {"$ref": "#/$defs/digest"},
        "resolution": {"$ref": "#/$defs/resolution"},
        "decision_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "verifier_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "resolutionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "rejected", "abstained", "disagreement", "timeout"],
      "properties": {
        "accepted": {"type": "integer", "minimum": 0, "maximum": 9},
        "rejected": {"type": "integer", "minimum": 0, "maximum": 9},
        "abstained": {"type": "integer", "minimum": 0, "maximum": 9},
        "disagreement": {"type": "integer", "minimum": 0, "maximum": 9},
        "timeout": {"type": "integer", "minimum": 0, "maximum": 9}
      }
    },
    "blocker": {"enum": ["EVIDENCE_COMPLETION_AUTHORITY_MISSING", "RANGE_CONNECTION_AUTHORIZATION_MISSING", "EXECUTION_AUTHORIZATION_MISSING", "OWNER_NAMED_SACRIFICIAL_RANGE_MISSING", "REAL_READ_ONLY_OBSERVATIONS_MISSING", "REAL_INDEPENDENT_VERIFIER_ACCEPTANCE_MISSING", "ALL_REQUIRED_CONTROLS_NOT_ACCEPTED"]},
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_contact_performed", "collection_performed", "infrastructure_provisioned", "host_or_network_policy_changed", "credentials_handled", "tools_installed", "network_contact_performed", "range_connected", "campaign_executed"],
      "properties": {
        "environment_contact_performed": {"const": false},
        "collection_performed": {"const": false},
        "infrastructure_provisioned": {"const": false},
        "host_or_network_policy_changed": {"const": false},
        "credentials_handled": {"const": false},
        "tools_installed": {"const": false},
        "network_contact_performed": {"const": false},
        "range_connected": {"const": false},
        "campaign_executed": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_collect", "can_install", "can_provision", "can_change_policy", "can_access_credentials", "can_connect", "can_execute", "can_mark_evidence_complete", "can_authorize_action"],
      "properties": {
        "can_collect": {"const": false},
        "can_install": {"const": false},
        "can_provision": {"const": false},
        "can_change_policy": {"const": false},
        "can_access_credentials": {"const": false},
        "can_connect": {"const": false},
        "can_execute": {"const": false},
        "can_mark_evidence_complete": {"const": false},
        "can_authorize_action": {"const": false}
      }
    }
  }
}
