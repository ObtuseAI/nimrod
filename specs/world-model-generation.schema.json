{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimrod.local/world-model-generation.schema.json",
  "title": "nimrod CACIS world model generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["generation_version", "generation_digest", "generation"],
  "properties": {
    "generation_version": {"const": "0.1.0"},
    "generation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_id", "origin", "scenario_id", "scenario_digest", "previous_generation_digest", "generated_at", "observation_set_digest", "observation_digests", "domains", "summary", "replay", "authority", "security_claim"],
      "properties": {
        "generation_id": {"type": "string", "format": "uuid"},
        "origin": {"const": "replayed"},
        "scenario_id": {"type": "string", "format": "uuid"},
        "scenario_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "previous_generation_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "generated_at": {"type": "string", "format": "date-time"},
        "observation_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "observation_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "domains": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/domainState"}},
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["known_domain_count", "partially_known_domain_count", "unknown_domain_count", "contradictory_domain_count", "known_fact_count", "unknown_fact_count", "stale_fact_count", "contradictory_fact_count"],
          "properties": {
            "known_domain_count": {"type": "integer", "minimum": 0},
            "partially_known_domain_count": {"type": "integer", "minimum": 0},
            "unknown_domain_count": {"type": "integer", "minimum": 0},
            "contradictory_domain_count": {"type": "integer", "minimum": 0},
            "known_fact_count": {"type": "integer", "minimum": 0},
            "unknown_fact_count": {"type": "integer", "minimum": 0},
            "stale_fact_count": {"type": "integer", "minimum": 0},
            "contradictory_fact_count": {"type": "integer", "minimum": 0}
          }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observation_count", "first_sequence", "last_sequence", "duplicate_count", "out_of_order_count", "deterministic"],
          "properties": {
            "observation_count": {"type": "integer", "minimum": 1},
            "first_sequence": {"const": 1},
            "last_sequence": {"type": "integer", "minimum": 1},
            "duplicate_count": {"const": 0},
            "out_of_order_count": {"const": 0},
            "deterministic": {"const": true}
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["can_authorize", "can_execute", "can_change_policy", "can_contact_targets", "policy_input_ready", "production_truth_claimed"],
          "properties": {
            "can_authorize": {"const": false},
            "can_execute": {"const": false},
            "can_change_policy": {"const": false},
            "can_contact_targets": {"const": false},
            "policy_input_ready": {"const": false},
            "production_truth_claimed": {"const": false}
          }
        },
        "security_claim": {"const": "Deterministic replay derived world state; no live sensing, policy readiness, execution, containment, recovery, or production truth established"}
      }
    }
  },
  "$defs": {
    "domainState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "knowledge_state", "facts", "missing_requirements"],
      "properties": {
        "domain": {"enum": ["identity", "endpoint", "network", "cloud", "threat", "recovery"]},
        "knowledge_state": {"enum": ["known", "partially_known", "unknown", "contradictory"]},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/factState"}},
        "missing_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    },
    "factState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "subject_type", "fact_key", "state", "candidates", "derived_from_observation_digests"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 3},
        "subject_type": {"type": "string", "minLength": 2},
        "fact_key": {"type": "string", "minLength": 3},
        "state": {"enum": ["known", "unknown", "stale", "contradictory"]},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
        "derived_from_observation_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "value", "confidence", "observed_at", "valid_until", "source_ids", "evidence_refs"],
      "properties": {
        "posture": {"enum": ["observed", "unknown"]},
        "value": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
      }
    }
  }
}
