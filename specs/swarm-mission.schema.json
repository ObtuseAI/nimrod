{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.nimrod.invalid/v0.1/swarm-mission.schema.json",
  "title": "nimrod Governed Swarm Mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_version",
    "mission_id",
    "origin",
    "authorization_lease_id",
    "objective",
    "proposal_only",
    "cells",
    "separation_rules",
    "work_items",
    "success_contract",
    "failure_contract"
  ],
  "properties": {
    "mission_version": { "const": "0.1.0" },
    "mission_id": { "$ref": "#/$defs/uuid" },
    "origin": { "const": "simulated" },
    "authorization_lease_id": { "$ref": "#/$defs/uuid" },
    "objective": { "$ref": "#/$defs/nonEmptyString" },
    "proposal_only": { "const": true },
    "cells": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "role", "lens", "allowed_outputs", "prohibited_capabilities", "work_budget"],
        "properties": {
          "agent_id": { "$ref": "#/$defs/capability" },
          "role": { "$ref": "#/$defs/role" },
          "lens": { "$ref": "#/$defs/nonEmptyString" },
          "allowed_outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "hypothesis",
                "coverage_challenge",
                "typed_test_proposal",
                "evidence_assessment",
                "recovery_proposal",
                "safety_veto",
                "dissent"
              ]
            }
          },
          "prohibited_capabilities": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/nonEmptyString" }
          },
          "work_budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maximum_items", "maximum_seconds"],
            "properties": {
              "maximum_items": { "type": "integer", "minimum": 1 },
              "maximum_seconds": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "separation_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_cannot_verify",
        "executor_absent",
        "safety_governor_veto",
        "independent_verifier_required",
        "minimum_distinct_roles"
      ],
      "properties": {
        "planner_cannot_verify": { "const": true },
        "executor_absent": { "const": true },
        "safety_governor_veto": { "const": true },
        "independent_verifier_required": { "const": true },
        "minimum_distinct_roles": { "type": "integer", "minimum": 5 }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "assigned_agent_id", "work_type", "target_id", "technique_id", "depends_on"],
        "properties": {
          "work_id": { "$ref": "#/$defs/nonEmptyString" },
          "assigned_agent_id": { "$ref": "#/$defs/capability" },
          "work_type": {
            "enum": [
              "hypothesize",
              "challenge_coverage",
              "compile_typed_test",
              "assess_evidence",
              "plan_recovery",
              "review_safety"
            ]
          },
          "target_id": { "$ref": "#/$defs/nonEmptyString" },
          "technique_id": { "$ref": "#/$defs/nonEmptyString" },
          "depends_on": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
        }
      }
    },
    "success_contract": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "failure_contract": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$" },
    "role": {
      "enum": [
        "offensive_planner",
        "defensive_hunter",
        "purple_compiler",
        "evidence_analyst",
        "recovery_planner",
        "independent_verifier",
        "safety_governor"
      ]
    }
  }
}
