{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.nimrod.invalid/v0.1/authorization-lease.schema.json",
  "title": "nimrod Authorization Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_version",
    "lease_id",
    "customer_id",
    "authority_proof",
    "approvals",
    "issued_at",
    "not_before",
    "expires_at",
    "nonce",
    "target_graph",
    "allowed_techniques",
    "allowed_capabilities",
    "effect_ceiling",
    "prohibited_actions",
    "budgets",
    "preflight_requirements",
    "kill_switch",
    "cleanup_requirements",
    "signatures"
  ],
  "properties": {
    "lease_version": { "const": "0.1.0" },
    "lease_id": { "$ref": "#/$defs/uuid" },
    "customer_id": { "$ref": "#/$defs/nonEmptyString" },
    "authority_proof": { "$ref": "#/$defs/reference" },
    "approvals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "not_before": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "nonce": { "$ref": "#/$defs/nonEmptyString" },
    "target_graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_id", "resource_type", "binding", "environment_class"],
        "properties": {
          "stable_id": { "$ref": "#/$defs/nonEmptyString" },
          "resource_type": { "$ref": "#/$defs/nonEmptyString" },
          "binding": { "type": "object", "minProperties": 1 },
          "environment_class": { "enum": ["twin", "range", "sacrificial_replica", "development", "staging", "production"] }
        }
      }
    },
    "allowed_techniques": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "allowed_capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "effect_ceiling": { "enum": ["observe_only", "reversible_local", "reversible_distributed", "sacrificial_replica_only"] },
    "prohibited_actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_actions", "maximum_concurrency", "maximum_seconds", "maximum_cost_usd", "maximum_export_bytes"],
      "properties": {
        "maximum_actions": { "type": "integer", "minimum": 1 },
        "maximum_concurrency": { "type": "integer", "minimum": 1 },
        "maximum_seconds": { "type": "integer", "minimum": 1 },
        "maximum_cost_usd": { "type": "number", "minimum": 0 },
        "maximum_export_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "preflight_requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "controller", "out_of_band", "maximum_revocation_seconds"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "controller": { "$ref": "#/$defs/nonEmptyString" },
        "out_of_band": { "const": true },
        "maximum_revocation_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "cleanup_requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "signatures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,127}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Fa-f0-9]{32,}$" }
      }
    }
  }
}

