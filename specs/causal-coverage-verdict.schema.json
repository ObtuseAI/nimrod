{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.nimrod.invalid/v0.1/causal-coverage-verdict.schema.json",
  "title": "nimrod Causal Coverage Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict_version",
    "verdict_id",
    "origin",
    "campaign_id",
    "step_id",
    "target_id",
    "observed_at",
    "status",
    "causal_chain",
    "assurance_vector",
    "supporting_evidence",
    "contradicting_evidence",
    "uncertainties",
    "residual_risks",
    "verifier_signatures"
  ],
  "properties": {
    "verdict_version": { "const": "0.2.0" },
    "verdict_id": { "$ref": "#/$defs/uuid" },
    "origin": { "enum": ["simulated", "replayed", "range", "sacrificial_replica", "live"] },
    "campaign_id": { "$ref": "#/$defs/uuid" },
    "step_id": { "$ref": "#/$defs/nonEmptyString" },
    "target_id": { "$ref": "#/$defs/nonEmptyString" },
    "observed_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "not_attempted",
        "ineffective",
        "prevented",
        "unobserved",
        "normalization_gap",
        "detection_gap",
        "response_gap",
        "recovery_gap",
        "verified",
        "contradicted",
        "inconclusive_timeout"
      ]
    },
    "causal_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "attempt", "state_delta", "observation", "detection", "response", "recovery", "post_state"],
      "properties": {
        "intent": { "$ref": "#/$defs/referenceOrNull" },
        "attempt": { "$ref": "#/$defs/referenceOrNull" },
        "state_delta": { "$ref": "#/$defs/referenceOrNull" },
        "observation": { "$ref": "#/$defs/referenceOrNull" },
        "detection": { "$ref": "#/$defs/referenceOrNull" },
        "response": { "$ref": "#/$defs/referenceOrNull" },
        "recovery": { "$ref": "#/$defs/referenceOrNull" },
        "post_state": { "$ref": "#/$defs/referenceOrNull" }
      }
    },
    "assurance_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prevention", "observation", "detection", "correlation", "response", "recovery", "precision", "evidence_completeness", "privacy", "performance", "uncertainty", "freshness_seconds"],
      "properties": {
        "prevention": { "$ref": "#/$defs/scoreOrNull" },
        "observation": { "$ref": "#/$defs/scoreOrNull" },
        "detection": { "$ref": "#/$defs/scoreOrNull" },
        "correlation": { "$ref": "#/$defs/scoreOrNull" },
        "response": { "$ref": "#/$defs/scoreOrNull" },
        "recovery": { "$ref": "#/$defs/scoreOrNull" },
        "precision": { "$ref": "#/$defs/scoreOrNull" },
        "evidence_completeness": { "$ref": "#/$defs/scoreOrNull" },
        "privacy": { "$ref": "#/$defs/scoreOrNull" },
        "performance": { "$ref": "#/$defs/scoreOrNull" },
        "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "supporting_evidence": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "contradicting_evidence": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "uncertainties": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "residual_risks": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
    "verifier_signatures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "scoreOrNull": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]*:[A-Fa-f0-9]{32,}$" }
      }
    },
    "referenceOrNull": { "oneOf": [{ "$ref": "#/$defs/reference" }, { "type": "null" }] }
  }
}
