{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://specs.nimrod.invalid/v0.1/evolution-transition-envelope.schema.json",
  "title": "nimrod Threshold-Signed Evolution Transition Envelope", "type": "object", "additionalProperties": false,
  "required": ["envelope_version", "envelope_id", "origin", "candidate_digest", "evaluation_digest", "capability_report_digest", "constitution_digest", "active_baseline_digest", "action", "destination", "sequence", "previous_receipt_digest", "issued_at", "not_before", "expires_at", "authority", "signatures"],
  "properties": {
    "envelope_version": {"const": "0.1.0"}, "envelope_id": {"type": "string", "format": "uuid"}, "origin": {"const": "simulated"}, "candidate_digest": {"$ref": "#/$defs/digest"}, "evaluation_digest": {"$ref": "#/$defs/digest"}, "capability_report_digest": {"$ref": "#/$defs/digest"}, "constitution_digest": {"$ref": "#/$defs/digest"}, "active_baseline_digest": {"$ref": "#/$defs/digest"},
    "action": {"enum": ["register_shadow", "demote", "rollback"]}, "destination": {"enum": ["shadow", "quarantine", "rolled_back"]}, "sequence": {"type": "integer", "minimum": 1}, "previous_receipt_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "issued_at": {"type": "string", "format": "date-time"}, "not_before": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["can_modify_active_baseline", "can_execute_candidate", "can_promote_to_production", "can_expand_authority"], "properties": {"can_modify_active_baseline": {"const": false}, "can_execute_candidate": {"const": false}, "can_promote_to_production": {"const": false}, "can_expand_authority": {"const": false}}},
    "signatures": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/signature"}}
  }, "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "signature": {"type": "object", "additionalProperties": false, "required": ["signer_id", "algorithm", "signature_base64"], "properties": {"signer_id": {"type": "string", "minLength": 1}, "algorithm": {"const": "Ed25519"}, "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}}}}
}
