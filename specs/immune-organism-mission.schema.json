{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimrod.local/immune-organism-mission.schema.json",
  "title": "nimrod CACIS immune organism mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_version", "mission_id", "origin", "world_model_generation_digest", "incident_class", "issued_at", "not_before", "expires_at", "maximum_outcome", "governor", "capability_lease", "resource_lease", "cells", "shadow_policy", "authority"],
  "properties": {
    "mission_version": {"const": "0.1.0"},
    "mission_id": {"type": "string", "format": "uuid"},
    "origin": {"const": "replayed"},
    "world_model_generation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "incident_class": {"enum": ["credential_theft", "suspicious_script"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "maximum_outcome": {"const": "typed_proposal"},
    "governor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governor_id", "decision_id", "schedule_strategy", "can_authorize", "can_execute"],
      "properties": {
        "governor_id": {"type": "string", "pattern": "^governor:[a-z0-9_.-]+$"},
        "decision_id": {"type": "string", "format": "uuid"},
        "schedule_strategy": {"const": "deterministic_minimum_capability"},
        "can_authorize": {"const": false},
        "can_execute": {"const": false}
      }
    },
    "capability_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "allowed_capabilities", "prohibited_capabilities", "ambient_credentials_allowed", "raw_command_bridge_allowed"],
      "properties": {
        "lease_id": {"type": "string", "format": "uuid"},
        "allowed_capabilities": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["read_world_model", "derive_observation", "emit_typed_contribution", "retain_candidate_knowledge"]}},
        "prohibited_capabilities": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"enum": ["authorize", "execute", "change_policy", "contact_target", "use_credential", "raw_command", "self_verify", "promote_knowledge"]}},
        "ambient_credentials_allowed": {"const": false},
        "raw_command_bridge_allowed": {"const": false}
      }
    },
    "resource_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "expires_at", "cpu_millis", "memory_mb", "storage_bytes", "telemetry_reads", "model_calls", "sandbox_runs"],
      "properties": {
        "lease_id": {"type": "string", "format": "uuid"},
        "expires_at": {"type": "string", "format": "date-time"},
        "cpu_millis": {"type": "integer", "minimum": 1, "maximum": 10000},
        "memory_mb": {"type": "integer", "minimum": 1, "maximum": 512},
        "storage_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "telemetry_reads": {"type": "integer", "minimum": 1, "maximum": 64},
        "model_calls": {"const": 0},
        "sandbox_runs": {"const": 0}
      }
    },
    "cells": {"type": "array", "minItems": 6, "maxItems": 12, "items": {"$ref": "#/$defs/cell"}},
    "shadow_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shadow_cell_id", "allowed_controls", "automatic_termination_triggers", "can_authorize", "can_execute"],
      "properties": {
        "shadow_cell_id": {"type": "string", "format": "uuid"},
        "allowed_controls": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["pause", "downgrade", "spawn_challenge", "abstain", "resume", "terminate"]}},
        "automatic_termination_triggers": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["lease_expiry", "resource_exhaustion", "authority_violation"]}},
        "can_authorize": {"const": false},
        "can_execute": {"const": false}
      }
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "role", "capabilities", "can_self_verify", "can_authorize", "can_execute"],
      "properties": {
        "cell_id": {"type": "string", "format": "uuid"},
        "role": {"enum": ["identity", "endpoint", "network", "cloud", "threat", "recovery", "evidence", "historian", "script_analysis", "memory_analysis", "behavior", "containment", "shadow"]},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read_world_model", "derive_observation", "emit_typed_contribution", "retain_candidate_knowledge"]}},
        "can_self_verify": {"const": false},
        "can_authorize": {"const": false},
        "can_execute": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_authorize", "can_execute", "can_change_policy", "can_contact_targets", "can_use_credentials", "can_self_verify", "can_promote"],
      "properties": {
        "can_authorize": {"const": false},
        "can_execute": {"const": false},
        "can_change_policy": {"const": false},
        "can_contact_targets": {"const": false},
        "can_use_credentials": {"const": false},
        "can_self_verify": {"const": false},
        "can_promote": {"const": false}
      }
    }
  }
}
