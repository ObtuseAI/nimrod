{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://specs.nimrod.invalid/v0.1/cognitive-candidate-bundle.schema.json",
  "title": "nimrod Cognitive Candidate Bundle", "type": "object", "additionalProperties": false,
  "required": ["bundle_version", "candidate_id", "origin", "compiled_at", "source_candidate_digest", "active_baseline_digest", "constitution_digest", "candidate_class", "authority_tier", "lens", "mutation_family", "epistemic_posture", "source_evidence", "contradicting_evidence", "proposed_delta_digest", "proposed_delta_retained", "prediction", "uncertainty", "resource_lease", "rollback_digest", "status", "active_baseline_modified", "candidate_executed", "authority"],
  "properties": {
    "bundle_version": {"const": "0.1.0"}, "candidate_id": {"type": "string", "format": "uuid"}, "origin": {"const": "simulated"}, "compiled_at": {"type": "string", "format": "date-time"},
    "source_candidate_digest": {"$ref": "#/$defs/digest"}, "active_baseline_digest": {"$ref": "#/$defs/digest"}, "constitution_digest": {"$ref": "#/$defs/digest"},
    "candidate_class": {"enum": ["knowledge", "fixture", "detection", "scoring", "playbook", "connector", "model", "policy", "executable"]}, "authority_tier": {"enum": ["A", "B", "C", "D"]},
    "lens": {"enum": ["precision", "systems", "adversarial", "synthesis"]}, "mutation_family": {"type": "string", "minLength": 1},
    "epistemic_posture": {"type": "object"}, "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}}, "contradicting_evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "proposed_delta_digest": {"$ref": "#/$defs/digest"}, "proposed_delta_retained": {"const": false}, "prediction": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["level", "known_limitations"], "properties": {"level": {"enum": ["bounded", "high", "unknown"]}, "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "resource_lease": {"type": "object", "additionalProperties": false, "required": ["cycle_id", "maximum_cycle_seconds", "maximum_compute_units", "maximum_memory_megabytes", "maximum_storage_megabytes", "maximum_candidate_children", "expires_at", "authority"], "properties": {"cycle_id": {"type": "string", "format": "uuid"}, "maximum_cycle_seconds": {"type": "integer", "minimum": 1}, "maximum_compute_units": {"type": "integer", "minimum": 1}, "maximum_memory_megabytes": {"type": "integer", "minimum": 1}, "maximum_storage_megabytes": {"type": "integer", "minimum": 1}, "maximum_candidate_children": {"type": "integer", "minimum": 1}, "expires_at": {"type": "string", "format": "date-time"}, "authority": {"type": "object", "additionalProperties": false, "required": ["can_self_extend", "can_purchase_compute"], "properties": {"can_self_extend": {"const": false}, "can_purchase_compute": {"const": false}}}}},
    "rollback_digest": {"$ref": "#/$defs/digest"}, "status": {"const": "quarantined"}, "active_baseline_modified": {"const": false}, "candidate_executed": {"const": false},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "reference": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}}, "authority": {"type": "object", "additionalProperties": false, "required": ["can_execute", "can_modify_active_baseline", "can_modify_constitution", "can_modify_evaluators", "can_select_signers", "can_access_sealed_answers", "can_acquire_credentials", "can_expand_network", "can_replicate_or_persist", "can_expand_compute"], "properties": {"can_execute": {"const": false}, "can_modify_active_baseline": {"const": false}, "can_modify_constitution": {"const": false}, "can_modify_evaluators": {"const": false}, "can_select_signers": {"const": false}, "can_access_sealed_answers": {"const": false}, "can_acquire_credentials": {"const": false}, "can_expand_network": {"const": false}, "can_replicate_or_persist": {"const": false}, "can_expand_compute": {"const": false}}}}
}
