{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.nimrod.invalid/v0.1/range-verifier-policy.schema.json",
  "title": "nimrod Independent Range Evidence Verifier Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "policy_id", "origin", "status", "governance_state_digest", "admission_report_id", "admission_report_digest", "scope_digest", "environment_id", "issued_at", "not_before", "expires_at", "minimum_decisions_per_observation", "allowed_decisions", "verifiers", "blockers", "authority", "signatures"],
  "properties": {
    "policy_version": {"const": "0.1.0"},
    "policy_id": {"type": "string", "format": "uuid"},
    "origin": {"$ref": "#/$defs/origin"},
    "status": {"enum": ["fixture_policy_non_accepting", "external_evidence_decisions_allowed"]},
    "governance_state_digest": {"$ref": "#/$defs/digest"},
    "admission_report_id": {"type": "string", "format": "uuid"},
    "admission_report_digest": {"$ref": "#/$defs/digest"},
    "scope_digest": {"$ref": "#/$defs/digest"},
    "environment_id": {"$ref": "#/$defs/nonEmptyString"},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "minimum_decisions_per_observation": {"const": 2},
    "allowed_decisions": {"const": ["abstain", "accept", "reject", "timeout"]},
    "verifiers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/verifier"}},
    "blockers": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/blocker"}},
    "authority": {"$ref": "#/$defs/authority"},
    "signatures": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/signature"}}
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "simulated"}}},
      "then": {
        "properties": {
          "status": {"const": "fixture_policy_non_accepting"},
          "blockers": {"const": ["EVIDENCE_COMPLETION_AUTHORITY_MISSING", "REAL_INDEPENDENT_VERIFIER_ACCEPTANCE_MISSING"]}
        }
      },
      "else": {
        "properties": {
          "status": {"const": "external_evidence_decisions_allowed"},
          "blockers": {"const": ["EVIDENCE_COMPLETION_AUTHORITY_MISSING"]}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "origin": {"enum": ["simulated", "range", "sacrificial_replica"]},
    "blocker": {"enum": ["EVIDENCE_COMPLETION_AUTHORITY_MISSING", "REAL_INDEPENDENT_VERIFIER_ACCEPTANCE_MISSING"]},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "logical_principal", "process_id", "public_key_base64", "read_only", "operation_allowlist", "identity_enforcement", "independence_evidence_digest", "collector_identity_shared", "network_destinations", "secret_references"],
      "properties": {
        "verifier_id": {"$ref": "#/$defs/nonEmptyString"},
        "logical_principal": {"$ref": "#/$defs/nonEmptyString"},
        "process_id": {"type": "integer", "minimum": 1},
        "public_key_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
        "read_only": {"const": true},
        "operation_allowlist": {"const": ["emit_decision", "inspect_retained_observation"]},
        "identity_enforcement": {"enum": ["fixture_logical_only", "externally_attested"]},
        "independence_evidence_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "collector_identity_shared": {"const": false},
        "network_destinations": {"const": []},
        "secret_references": {"const": []}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_collect", "can_install", "can_provision", "can_change_policy", "can_access_credentials", "can_connect", "can_execute", "can_mark_evidence_complete", "can_authorize_action"],
      "properties": {
        "can_collect": {"const": false},
        "can_install": {"const": false},
        "can_provision": {"const": false},
        "can_change_policy": {"const": false},
        "can_access_credentials": {"const": false},
        "can_connect": {"const": false},
        "can_execute": {"const": false},
        "can_mark_evidence_complete": {"const": false},
        "can_authorize_action": {"const": false}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signer_id", "algorithm", "signature_base64"],
      "properties": {
        "signer_id": {"$ref": "#/$defs/nonEmptyString"},
        "algorithm": {"const": "Ed25519"},
        "signature_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
